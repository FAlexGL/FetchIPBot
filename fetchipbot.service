[Unit]
Description=FetchIP Telegram Bot — sends public IP changes via Telegram
After=network-online.target
Wants=network-online.target

[Service]
# --- Modify this value (yourUser) with your user ---
User=yourUser
# ---------------------------------
WorkingDirectory=/opt/fetchipbot
ExecStart=/usr/bin/java -jar /opt/fetchipbot/fetchipbot.jar --daemon 5
Type=simple
Restart=on-failure
RestartSec=15
StandardOutput=journal
StandardError=journal
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
